# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# QR HMAC secret (≥32 random bytes, base64 or hex)
GIFTCRAFT_QR_SECRET=
